+/* Releasing a browser handle does not promptly free GPU storage. Keep storage
+ * alive for recorded/submitted commands, then destroy it when their references
+ * retire. Persistent resource generations are marked only on release/cycling. */
+static void WEBGPU_DestroyBufferWhenUnused(WebGPURenderer *renderer, WGPUBuffer buffer)
+{
+    if (!buffer) return;
+    SDL_LockMutex(renderer->resource_lock);
+    for (Uint32 i = 0; i < renderer->buffer_reference_count; i++) {
+        if (renderer->buffer_references[i].buffer == buffer) {
+            renderer->buffer_references[i].destroy_when_unused = true;
+            SDL_UnlockMutex(renderer->resource_lock);
+            return;
+        }
+    }
+    SDL_UnlockMutex(renderer->resource_lock);
+    wgpuBufferDestroy(buffer);
+}
+
+static void WEBGPU_DestroyTextureWhenUnused(WebGPURenderer *renderer, WGPUTexture texture)
+{
+    if (!texture) return;
+    SDL_LockMutex(renderer->resource_lock);
+    for (Uint32 i = 0; i < renderer->texture_reference_count; i++) {
+        if (renderer->texture_references[i].texture == texture) {
+            renderer->texture_references[i].destroy_when_unused = true;
+            SDL_UnlockMutex(renderer->resource_lock);
+            return;
+        }
+    }
+    SDL_UnlockMutex(renderer->resource_lock);
+    wgpuTextureDestroy(texture);
+}
