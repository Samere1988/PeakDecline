+static void WEBGPU_ReferenceCacheKey(const WebGPUResourceBindGroupCacheKey *key, bool retain)
+{
+    if (retain) wgpuBindGroupLayoutAddRef(key->layout); else wgpuBindGroupLayoutRelease(key->layout);
+    for (Uint32 i = 0; i < key->sampled_texture_count; i++) {
+        if (key->sampled_textures[i].view) {
+            if (retain) wgpuTextureViewAddRef(key->sampled_textures[i].view); else wgpuTextureViewRelease(key->sampled_textures[i].view);
+        }
+        if (key->sampled_textures[i].sampler) {
+            if (retain) wgpuSamplerAddRef(key->sampled_textures[i].sampler); else wgpuSamplerRelease(key->sampled_textures[i].sampler);
+        }
+    }
+    for (Uint32 i = 0; i < key->storage_texture_count; i++) {
+        if (retain) wgpuTextureViewAddRef(key->storage_textures[i].view); else wgpuTextureViewRelease(key->storage_textures[i].view);
+    }
+    for (Uint32 i = 0; i < key->storage_buffer_count; i++) {
+        if (retain) wgpuBufferAddRef(key->storage_buffers[i].buffer); else wgpuBufferRelease(key->storage_buffers[i].buffer);
+    }
+}
+
+/* Cache keys own their handles, preventing address reuse from aliasing an old
+ * key. Groups are immutable; each command still owns its submitted reference. */
+static WGPUBindGroup WEBGPU_FindPersistentBindGroup(WebGPURenderer *renderer, const WebGPUResourceBindGroupCacheKey *key)
+{
+    WGPUBindGroup group = NULL;
+    SDL_LockMutex(renderer->resource_lock);
+    for (Uint32 i = 0; i < renderer->persistent_bind_group_count; i++) {
+        WebGPUResourceBindGroupCacheEntry *entry = &renderer->persistent_bind_groups[i];
+        if (WEBGPU_ResourceBindGroupCacheKeysMatch(&entry->key, key)) {
+            entry->last_used = ++renderer->persistent_bind_group_clock;
+            group = entry->bind_group;
+            wgpuBindGroupAddRef(group);
+            break;
+        }
+    }
+    SDL_UnlockMutex(renderer->resource_lock);
+    return group;
+}
+
+static void WEBGPU_InsertPersistentBindGroup(WebGPURenderer *renderer, const WebGPUResourceBindGroupCacheKey *key, WGPUBindGroup group)
+{
+    SDL_LockMutex(renderer->resource_lock);
+    Uint32 slot = renderer->persistent_bind_group_count;
+    if (slot < SDL_arraysize(renderer->persistent_bind_groups)) renderer->persistent_bind_group_count++;
+    else {
+        slot = 0;
+        for (Uint32 i = 1; i < renderer->persistent_bind_group_count; i++) {
+            if (renderer->persistent_bind_groups[i].last_used < renderer->persistent_bind_groups[slot].last_used) slot = i;
+        }
+        WEBGPU_ReferenceCacheKey(&renderer->persistent_bind_groups[slot].key, false);
+        wgpuBindGroupRelease(renderer->persistent_bind_groups[slot].bind_group);
+    }
+    WebGPUResourceBindGroupCacheEntry *entry = &renderer->persistent_bind_groups[slot];
+    entry->key = *key;
+    WEBGPU_ReferenceCacheKey(key, true);
+    entry->bind_group = group;
+    wgpuBindGroupAddRef(group);
+    entry->last_used = ++renderer->persistent_bind_group_clock;
+    SDL_UnlockMutex(renderer->resource_lock);
+}
+
+static void WEBGPU_ClearPersistentBindGroups(WebGPURenderer *renderer)
+{
+    for (Uint32 i = 0; i < renderer->persistent_bind_group_count; i++) {
+        WEBGPU_ReferenceCacheKey(&renderer->persistent_bind_groups[i].key, false);
+        wgpuBindGroupRelease(renderer->persistent_bind_groups[i].bind_group);
+    }
+    renderer->persistent_bind_group_count = 0;
+    for (Uint32 i = 0; i < renderer->free_uniform_page_count; i++) {
+        wgpuBufferDestroy(renderer->free_uniform_pages[i]);
+        wgpuBufferRelease(renderer->free_uniform_pages[i]);
+    }
+    renderer->free_uniform_page_count = 0;
+}
