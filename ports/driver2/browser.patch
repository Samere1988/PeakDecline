+EM_ASYNC_JS(int, PeakLoadMovie, (const char* filename, int movie), {
+    const path=UTF8ToString(filename);
+    try {
+        const response=await fetch(document.body.dataset.dataUrl+'/fmv/'+movie);
+        if(!response.ok)throw new Error('Cutscene download failed ('+response.status+').');
+        FS.mkdirTree(path.slice(0,path.lastIndexOf('/')));
+        FS.writeFile(path,new Uint8Array(await response.arrayBuffer()));
+        return 1;
+    }catch(error){Module.onAbort(error.message);return 0;}
+});
+struct PeakMovieFile {
+    std::string path;
+    explicit PeakMovieFile(const char* filename):path(filename){}
+    ~PeakMovieFile(){remove(path.c_str());}
+};
